# Copy this file to `.env.development` (no `.example` suffix) before running `npm run dev`.
# `.env.development` itself is gitignored — only this template is tracked.
#
# VUE_APP_BASE_API is the URL prefix the frontend prepends to every API call.
# Requests are then forwarded by the webpack-dev-server proxy in vue.config.js
# to the FastAPI backend (default 127.0.0.1:5012).
VUE_APP_BASE_API = '/dev-api'

# Override only when the backend is on a different host/port (e.g. zombie
# socket forced you to a new port). Defaults to http://127.0.0.1:5012.
# VUE_APP_DEV_PROXY_TARGET = 'http://127.0.0.1:5013'
